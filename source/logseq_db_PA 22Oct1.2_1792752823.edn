   "(b) render the item inoperable by the removal of any part from it; or"]
  [10738 :block/updated-at 1792002820000]
  [10738 :block/uuid #uuid "6ad2f395-ea25-473e-bfbb-00e2fcfcda95"]
  [10739 :block/created-at 1792002820000]
  [10739 :block/order "c1jD"]
  [10739 :block/page 394]
  [10739 :block/parent 10745]
  [10739
   :block/title
   "(b) render the item inoperable by the removal of any part from it; or"]
  [10739 :block/updated-at 1792002820000]
  [10739 :block/uuid #uuid "6ad2f395-c0cb-4ffc-b029-8061eb6d790b"]
