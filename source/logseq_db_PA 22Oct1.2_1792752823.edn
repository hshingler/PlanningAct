  [9053 :block/parent 536]
  [9053
   :block/title
   "(1) When granting a planning consent, the consent authority may include any con- dition that it considers appropriate after being satisfied that—"]
  [9053 :block/updated-at 1792002820000]
  [9053 :block/uuid #uuid "6ad2f393-58cc-4f4c-bdb0-14b7c10d9d04"]
  [9054 :block/created-at 1792002820000]
  [9054 :block/order "c1G8"]
  [9054 :block/page 536]
  [9054 :block/parent 9047]
  [9054 :block/title "(c) the condition is directly connected to—"]
  [9054 :block/updated-at 1792002820000]
  [9054 :block/uuid #uuid "6ad2f393-173d-4603-a340-9529af5e7c0d"]
  [9055 :block/created-at 1792002820000]
  [9055 :block/order "c1GE"]
  [9055 :block/page 536]
  [9055 :block/parent 9059]
  [9055
   :block/title
   "(a) relates only to an effect that is outside the scope of this Act; or"]
  [9055 :block/updated-at 1792002820000]
  [9055 :block/uuid #uuid "6ad2f393-61ed-41e7-b894-46e6fd44732e"]
  [9056 :block/created-at 1792002820000]
  [9056 :block/order "c1G5"]
  [9056 :block/page 536]
  [9056 :block/parent 536]
  [9056 :block/refs 445]
  [9056 :block/refs 906]
  [9056
   :block/title
   "(4) This section does not limit [section 171]([[6ad2f38a-12f1-4e57-aa15-3d5d959e4a73]]) or 172 or Part 1 of [Schedule 7]([[6ad2f38b-c162-4df6-808f-6483d9eecf14]])."]
  [9056 :block/updated-at 1792002820000]
  [9056 :block/uuid #uuid "6ad2f393-f339-47bc-878a-fb138fc1a505"]
