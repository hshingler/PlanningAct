  [8636 :block/uuid #uuid "6ad2f393-d1e9-4a71-8035-50445794d1d7"]
  [8637 :block/created-at 1792002820000]
  [8637 :block/order "c18t"]
  [8637 :block/page 359]
  [8637 :block/parent 359]
  [8637
   :block/title
   "(1) A person exercising or performing a function, power, or duty under this Act who is deciding a matter relating to a planning consent must comply with sec- tion 14(3)(a) in accordance with this section."]
  [8637 :block/updated-at 1792002820000]
  [8637 :block/uuid #uuid "6ad2f393-dffd-4524-a9c9-8cd2c860479c"]
