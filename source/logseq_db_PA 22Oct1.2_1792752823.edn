  [9058 :block/page 536]
  [9058 :block/parent 9060]
  [9058
   :block/title
   "(ii) an applicable provision in a land use plan or national rule; or"]
  [9058 :block/updated-at 1792002820000]
  [9058 :block/uuid #uuid "6ad2f393-22ee-4785-aee9-d76da0deba26"]
  [9059 :block/created-at 1792002820000]
  [9059 :block/order "c1G4"]
