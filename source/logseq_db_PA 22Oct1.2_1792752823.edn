  [6911 :block/created-at 1792002820000]
  [6911 :block/order "c0hk"]
  [6911 :block/page 903]
  [6911 :block/parent 7042]
  [6911
   :block/title
   "(5) For the purposes of subclause (1), the court may assume that an amount repre- sents any monetary benefit acquired by a person, or accrued or accruing to the person, as a result of the commission of an offence or contravention if—"]
  [6911 :block/updated-at 1792002820000]
