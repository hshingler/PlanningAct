  [12928 :block/order "c2Ke"]
  [12928 :block/page 409]
  [12928 :block/parent 409]
  [12928 :block/refs 13876]
  [12928
   :block/title
   "(1) This section applies if 2 or more local authorities in a region, or the members of a [[6ad5b57f-dd2a-42d2-8d92-58043a01e788]], have failed to achieve consensus on a matter required for a decision after using the dispute resolution process prescribed by regulations."]
  [12928 :block/updated-at 1792563692158]
  [12928 :block/uuid #uuid "6ad2f398-3f2a-4337-a8ce-67c85d5b5adf"]
  [12930 :block/created-at 1792002820000]
