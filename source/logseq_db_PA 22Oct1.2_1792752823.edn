  [9033 :block/page 450]
  [9033 :block/parent 450]
  [9033 :block/title ""]
  [9033 :block/updated-at 1792396475126]
  [9033 :block/uuid #uuid "6ad2f393-b5e9-428c-b501-d4f61aaa1e6d"]
  [9034 :block/created-at 1792002820000]
  [9034 :block/order "c1Fr"]
  [9034 :block/page 450]
  [9034 :block/parent 450]
  [9034
   :block/title
   "(2) This section applies despite sections 38, 167, 168, and 198."]
  [9034 :block/updated-at 1792002820000]
  [9034 :block/uuid #uuid "6ad2f393-d384-4eb5-a23a-3f3babb370a0"]
  [9035 :block/created-at 1792002820000]
  [9035 :block/order "c1Fr"]
  [9035 :block/page 450]
  [9035 :block/parent 9037]
  [9035
   :block/title
   "(a) Te Ture Whaimana o Te Awa o Waikato—the Vision and Strategy for the Waikato River:"]
  [9035 :block/updated-at 1792002820000]
  [9035 :block/uuid #uuid "6ad2f393-1239-41ac-b30b-6feba34a5250"]
  [9037 :block/created-at 1792002820000]
  [9037 :block/order "c1Fq"]
  [9037 :block/page 450]
  [9037 :block/parent 450]
  [9037
   :block/title
   "(1) A consent authority may grant a planning consent contrary to a water services standard for the purpose of giving effect to any of the following:"]
