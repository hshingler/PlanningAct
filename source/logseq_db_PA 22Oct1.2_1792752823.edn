  [12945 :block/created-at 1792002820000]
  [12945 :block/order "c2Ky"]
  [12945 :block/page 337]
  [12945 :block/parent 337]
  [12945
   :block/title
   "(3) If a territorial authority gives notice under this section, this subpart (including Schedules 2 and 4) applies with the following modifications:"]
