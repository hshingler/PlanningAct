  [10715 :block/page 271]
  [10715 :block/parent 10718]
  [10715
   :block/title
   "(a) has received a complaint that excessive noise is being emitted from any place; and"]
  [10715 :block/updated-at 1792002820000]
  [10715 :block/uuid #uuid "6ad2f395-1f00-482f-8e9f-869218d593e5"]
  [10716 :block/created-at 1792002820000]
