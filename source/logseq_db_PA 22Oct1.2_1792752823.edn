  [10517 :block/order "c1fQ"]
  [10517 :block/page 380]
  [10517 :block/parent 10514]
  [10517
   :block/title
   "(3) Any person who is directly affected by an abatement notice may apply in writ- ing to the relevant authority to change or cancel the abatement notice."]
  [10517 :block/updated-at 1792002820000]
  [10517 :block/uuid #uuid "6ad2f395-f589-424f-85c2-18e47659b01b"]
  [10518 :block/created-at 1792002820000]
