   "(c) consider any submissions made within the period specified in paragraph"]
  [6904 :block/updated-at 1792002820000]
  [6904 :block/uuid #uuid "6ad2f391-0d2c-4338-81fc-33968c500173"]
  [6905 :block/created-at 1792002820000]
  [6905 :block/order "c0eb"]
  [6905 :block/page 903]
  [6905 :block/parent 6791]
  [6905
   :block/title
   "(2) If the registered bond is varied, cancelled, or expires, the Registrar-General of Land must make an appropriate entry in the register and on any relevant instru- ment of title noting that the bond has been varied or cancelled or has expired,"]
  [6905 :block/updated-at 1792002820000]
  [6905 :block/uuid #uuid "6ad2f391-2cf3-4c2d-8f75-e66b3f42da66"]
  [6906 :block/created-at 1792002820000]
  [6906 :block/order "c0eB"]
  [6906 :block/page 903]
  [6906 :block/parent 903]
