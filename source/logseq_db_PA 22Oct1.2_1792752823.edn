  [12932 :block/order "c2Kh"]
  [12932 :block/page 409]
  [12932 :block/parent 409]
  [12932
   :block/title
   "(4) The local authorities or spatial plan committee must comply with any informa- tion request from the Minister or independent person that are relevant to the matter."]
  [12932 :block/updated-at 1792002820000]
  [12932 :block/uuid #uuid "6ad2f398-8eed-40a1-99a1-e5d197d94c28"]
  [12933 :block/created-at 1792002820000]
  [12933 :block/order "c2Kl"]
  [12933 :block/page 409]
  [12933 :block/parent 12931]
  [12933
   :block/title
   "(a) consider any relevant information provided to them by the local author- ities or spatial plan committee; and"]
  [12933 :block/updated-at 1792002820000]
  [12933 :block/uuid #uuid "6ad2f398-acf3-4c05-a6fa-40b467434d28"]
  [12935 :block/created-at 1792002820000]
  [12935 :block/order "c2Ki"]
  [12935 :block/page 409]
  [12935 :block/parent 12940]
  [12935
   :block/title
   "(b) appoint an independent person to determine the matter."]
  [12935 :block/updated-at 1792002820000]
  [12935 :block/uuid #uuid "6ad2f398-b027-445d-97e2-c0876b870110"]
  [12936 :block/created-at 1792002820000]
  [12936 :block/order "c2Kk"]
  [12936 :block/page 409]
  [12936 :block/parent 409]
  [12936
   :block/title
   "(7) A determination is binding on the local authorities or spatial plan committee."]
  [12936 :block/updated-at 1792002820000]
  [12936 :block/uuid #uuid "6ad2f398-fa55-4934-b8db-646f6c2135b3"]
  [12937 :block/created-at 1792002820000]
  [12937 :block/order "c2Km"]
  [12937 :block/page 409]
  [12937 :block/parent 12931]
  [12937
   :block/title
   "(b) determine the matter, and advise the local authorities or spatial plan committee of the determination, within a reasonable time frame."]
  [12937 :block/updated-at 1792002820000]
  [12937 :block/uuid #uuid "6ad2f398-f8f9-4309-8bbd-cd99342d783e"]
  [12939 :block/created-at 1792002820000]
  [12939 :block/order "c2Kh"]
  [12939 :block/page 409]
  [12939 :block/parent 12940]
  [12939 :block/title "(a) determine the matter; or"]
  [12939 :block/updated-at 1792002820000]
  [12939 :block/uuid #uuid "6ad2f398-5f89-4616-985b-069b751a397d"]
  [12940 :block/created-at 1792002820000]
