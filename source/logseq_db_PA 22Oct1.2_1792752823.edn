  [10712 :block/order "c1iw"]
  [10712 :block/page 271]
  [10712 :block/parent 10714]
  [10712
   :block/title
   "(3) A direction under subsection (2) may be given in writing or orally."]
  [10712 :block/updated-at 1792002820000]
  [10712 :block/uuid #uuid "6ad2f395-593e-4efb-97ab-cf424e8cfce6"]
