  [6902 :block/uuid #uuid "6ad2f391-f2c2-41aa-85f9-c1abf3499517"]
  [6903 :block/created-at 1792002820000]
  [6903 :block/order "c0g7"]
  [6903 :block/page 903]
  [6903 :block/parent 6762]
  [6903
   :block/title
   "(a) have regard to the prescribed risk-assessment criteria (if any); and"]
