  [9896 :block/page 285]
  [9896 :block/parent 9895]
  [9896
   :block/title
   "(1) One or more iwi authorities may, at any time, request 1 or more local author- ities that have jurisdiction in relation to the areas of interest to the iwi author- ities to enter into 1 or more iwi participation agreements with those iwi author- ities."]
  [9896 :block/updated-at 1792002820000]
  [9896 :block/uuid #uuid "6ad2f394-ba72-4d3f-80a3-1f9a16390b9e"]
  [9897 :block/created-at 1792002820000]
  [9897 :block/order "c1Uj"]
  [9897 :block/page 285]
  [9897 :block/parent 9895]
  [9897
   :block/title
   "(2) Only 1 or more iwi authorities may request 1 or more local authorities to enter into iwi participation agreements."]
  [9897 :block/updated-at 1792002820000]
  [9897 :block/uuid #uuid "6ad2f394-18a8-4ffb-a88f-cd6c34fca2b6"]
  [9898 :block/created-at 1792002820000]
  [9898 :block/order "c1Uk"]
  [9898 :block/page 285]
  [9898 :block/parent 9895]
  [9898
