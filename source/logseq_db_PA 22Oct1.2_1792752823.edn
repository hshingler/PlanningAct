  [13511
   :block/title
   "e) In rural towns and rural settlements, provide for a broad mix of compatible"]
  [13511 :block/updated-at 1792297699241]
  [13511 :block/uuid #uuid "6ad44ae3-bd33-475e-be90-234ddabff9be"]
  [13512 :block/created-at 1792297716999]
