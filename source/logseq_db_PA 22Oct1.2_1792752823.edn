  [8656 :block/order "c19I"]
  [8656 :block/page 352]
  [8656 :block/parent 8652]
  [8656
   :block/title
   "(i) the person has given, and not withdrawn, approval for the pro- posed activity in a written notice received by the consent authority before the authority has decided whether there are any affected persons; or"]
  [8656 :block/updated-at 1792002820000]
  [8656 :block/uuid #uuid "6ad2f393-07f1-435f-b066-236d1a481b02"]
  [8658 :block/created-at 1792002820000]
  [8658 :block/order "c19O"]
  [8658 :block/page 352]
  [8658 :block/parent 8663]
  [8658 :block/title ""]
