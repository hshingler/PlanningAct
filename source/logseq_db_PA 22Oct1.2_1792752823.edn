  [7812 :block/parent 7445]
  [7812
   :block/title
   "(3) The Registrar may waive, reduce, or postpone the payment of the fee only if the Registrar is satisfied, after applying any criteria prescribed by the regula- tions, that—"]
  [7812 :block/updated-at 1792002820000]
  [7812 :block/uuid #uuid "6ad2f391-7758-4dc3-9450-22bfcd3e3e8d"]
  [7813 :block/created-at 1792002820000]
