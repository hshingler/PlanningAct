  [10488 :block/created-at 1792002820000]
  [10488 :block/order "c1f8"]
  [10488 :block/page 441]
  [10488 :block/parent 10501]
  [10488
   :block/title
   "(a) what the likely effect of granting a stay would be on the built environ- ment; and"]
  [10488 :block/updated-at 1792002820000]
  [10488 :block/uuid #uuid "6ad2f395-8e12-4b55-a06f-59656d30b4d5"]
  [10489 :block/created-at 1792002820000]
