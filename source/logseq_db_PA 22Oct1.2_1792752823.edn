  [9463 :block/uuid #uuid "6ad2f394-23da-4ed4-a79d-ee17edc373b3"]
  [9464 :block/created-at 1792002820000]
  [9464 :block/order "c1ND"]
  [9464 :block/page 235]
  [9464 :block/parent 9459]
  [9464
   :block/title
   "(a) for any breach of conditions of the consent that occurred before the sur- render of the consent; and"]
  [9464 :block/updated-at 1792002820000]
  [9464 :block/uuid #uuid "6ad2f394-6071-4b52-ab57-8390274e3963"]
  [9465 :block/created-at 1792209812203]
  [9465 :block/order "c1Nc"]
  [9465 :block/page 212]
  [9465 :block/parent 212]
  [9465 :block/title ""]
  [9465 :block/updated-at 1792209812203]
  [9465 :block/uuid #uuid "6ad2f394-5c75-4cd5-b13e-75d9657b9d3c"]
  [9466 :block/created-at 1792002820000]
  [9466 :block/order "c1NM"]
  [9466 :block/page 212]
  [9466 :block/parent 212]
  [9466 :block/title ""]
  [9466 :block/updated-at 1792002820000]
  [9466 :block/uuid #uuid "6ad2f394-94b6-4c2f-96ba-9b6b5b5133c8"]
  [9467 :block/created-at 1792002820000]
  [9467 :block/order "c1Na"]
  [9467 :block/page 212]
  [9467 :block/parent 9466]
  [9467
   :block/title
   "(5) A notice given under subsection (1)(d) lapses 5 years after the date of the notice unless the activity permitted by the notice is given effect to."]
  [9467 :block/updated-at 1792002820000]
  [9467 :block/uuid #uuid "6ad2f394-90ed-4a84-abd4-d29bfd29d1f0"]
  [9468 :block/created-at 1792002820000]
  [9468 :block/order "c1NN"]
  [9468 :block/page 212]
  [9468 :block/parent 9466]
  [9468 :block/title "(1) An activity is a permitted activity if—"]
  [9468 :block/updated-at 1792002820000]
  [9468 :block/uuid #uuid "6ad2f394-a7c2-4b2f-a197-c3456d92a02b"]
  [9469 :block/created-at 1792002820000]
  [9469 :block/order "c1NQ"]
  [9469 :block/page 212]
  [9469 :block/parent 9468]
  [9469
   :block/title
   "(c) any adverse effects of the activity on a person are minor or less than minor; and"]
  [9469 :block/updated-at 1792002820000]
  [9469 :block/uuid #uuid "6ad2f394-b067-42d9-94ea-4cc94932908c"]
  [9470 :block/created-at 1792002820000]
  [9470 :block/order "c1NT"]
  [9470 :block/page 212]
  [9470 :block/parent 9481]
  [9470
   :block/title
   "(a) after receiving an application for a planning consent for the activity; or"]
  [9470 :block/updated-at 1792002820000]
  [9470 :block/uuid #uuid "6ad2f394-d814-4d7e-b4fa-a36ed6b17b20"]
  [9471 :block/created-at 1792002820000]
  [9471 :block/order "c1NX"]
  [9471 :block/page 212]
  [9471 :block/parent 9483]
  [9471
   :block/title
   "(b) details of the site at which the activity is to occur; and"]
  [9471 :block/updated-at 1792002820000]
  [9471 :block/uuid #uuid "6ad2f394-cdb2-408f-95a6-b732e3846e5b"]
  [9472 :block/created-at 1792002820000]
  [9472 :block/order "c1NU"]
  [9472 :block/page 212]
  [9472 :block/parent 9481]
  [9472 :block/title "(b) on its own initiative."]
  [9472 :block/updated-at 1792002820000]
  [9472 :block/uuid #uuid "6ad2f394-55fd-4912-be42-0a4e2e42cfc2"]
  [9473 :block/created-at 1792002820000]
  [9473 :block/order "c1NY"]
  [9473 :block/page 212]
  [9473 :block/parent 9483]
  [9473
   :block/title
   "(c) the consent authority’s reasons for considering that the activity meets the criteria in subsection (1)(a) to (c) and the information relied on by the consent authority in making that decision."]
  [9473 :block/updated-at 1792002820000]
  [9473 :block/uuid #uuid "6ad2f394-8820-4451-bb52-7565eca9fd61"]
  [9474 :block/created-at 1792002820000]
  [9474 :block/order "c1NP"]
  [9474 :block/page 212]
  [9474 :block/parent 9468]
  [9474
   :block/title
   "(b) any adverse effects of the activity on the built environment are no differ- ent in character, intensity, or scale than they would be in the absence of the marginal or temporary non-compliance; and"]
  [9474 :block/updated-at 1792002820000]
  [9474 :block/uuid #uuid "6ad2f394-692d-44d3-8fe6-f3bbd203bf43"]
  [9475 :block/created-at 1792002820000]
  [9475 :block/order "c1NL"]
  [9475 :block/page 212]
  [9475 :block/parent 212]
  [9475 :block/refs 503]
  [9475 :block/title ""]
  [9475 :block/updated-at 1792002820000]
  [9475 :block/uuid #uuid "6ad2f394-f0ef-4aea-9203-dd7fd6123f2b"]
  [9476 :block/created-at 1792002820000]
  [9476 :block/order "c1NO"]
  [9476 :block/page 212]
  [9476 :block/parent 9468]
  [9476
   :block/title
   "(a) the activity would be a permitted activity except for a marginal or tem- porary non-compliance with requirements, conditions, and permissions specified in this Act, regulations, a land use plan, or a proposed land use plan; and"]
  [9476 :block/updated-at 1792002820000]
  [9476 :block/uuid #uuid "6ad2f394-f193-49e7-9df3-dff075be8082"]
  [9477 :block/created-at 1792002820000]
  [9477 :block/order "c1Nb"]
  [9477 :block/page 212]
  [9477 :block/parent 9466]
  [9477 :block/title ""]
  [9477 :block/updated-at 1792002820000]
  [9477 :block/uuid #uuid "6ad2f394-cd56-4f0c-aa49-3b6c8b7d3e35"]
  [9478 :block/created-at 1792002820000]
  [9478 :block/order "c1NK"]
  [9478 :block/page 212]
  [9478 :block/parent 212]
  [9478 :block/title ""]
  [9478 :block/updated-at 1792002820000]
  [9478 :block/uuid #uuid "6ad2f394-098a-482e-8e48-5dedc58d2029"]
  [9479 :block/created-at 1792002820000]
  [9479 :block/order "c1NW"]
  [9479 :block/page 212]
  [9479 :block/parent 9483]
  [9479 :block/title "(a) a description of the activity; and"]
  [9479 :block/updated-at 1792002820000]
  [9479 :block/uuid #uuid "6ad2f394-d894-4d91-9b23-f84fc9a65666"]
  [9480 :block/created-at 1792002820000]
  [9480 :block/order "c1NR"]
  [9480 :block/page 212]
  [9480 :block/parent 9468]
  [9480
   :block/title
   "(d) the consent authority, in its discretion, decides to notify the person pro- posing to undertake the activity that the activity is a permitted activity."]
  [9480 :block/updated-at 1792002820000]
  [9480 :block/uuid #uuid "6ad2f394-bc9d-4516-8230-901a6fd5c045"]
  [9481 :block/created-at 1792002820000]
  [9481 :block/order "c1NS"]
  [9481 :block/page 212]
  [9481 :block/parent 9466]
  [9481
   :block/title
   "(2) A consent authority may give a notice under subsection (1)(d)—"]
  [9481 :block/updated-at 1792002820000]
  [9481 :block/uuid #uuid "6ad2f394-9358-48e4-b02b-f7d87a9c7a82"]
  [9482 :block/created-at 1792002820000]
  [9482 :block/order "c1NZ"]
  [9482 :block/page 212]
  [9482 :block/parent 9466]
  [9482
   :block/title
   "(4) If a person has submitted an application for a planning consent for an activity that is a permitted activity under this section, the application need not be fur- ther processed, considered, or decided and must be returned to the applicant."]
  [9482 :block/updated-at 1792002820000]
  [9482 :block/uuid #uuid "6ad2f394-c196-4ef4-83c2-300dc0f900ed"]
  [9483 :block/created-at 1792002820000]
  [9483 :block/order "c1NV"]
  [9483 :block/page 212]
  [9483 :block/parent 9466]
  [9483
   :block/title
   "(3) The notice must be in writing and must include—"]
  [9483 :block/updated-at 1792002820000]
  [9483 :block/uuid #uuid "6ad2f394-b68d-4281-bed9-33274f5b3e77"]
  [9484 :block/created-at 1792209812227]
  [9484 :block/order "c1O6"]
  [9484 :block/page 314]
  [9484 :block/parent 314]
  [9484 :block/title ""]
  [9484 :block/updated-at 1792209812227]
  [9484 :block/uuid #uuid "6ad2f394-f3e8-42d5-bd4c-8ad757caecb1"]
  [9485 :block/created-at 1792002820000]
  [9485 :block/order "c1Ns"]
  [9485 :block/page 314]
  [9485 :block/parent 9487]
  [9485 :block/refs 212]
  [9485
   :block/title
   "(a) a notice for the activity is in force under [section 207]([[6ad2f38a-9914-428b-8017-c79c8f6c77ce]])(1)(d); or"]
  [9485 :block/updated-at 1792002820000]
  [9485 :block/uuid #uuid "6ad2f394-61db-42ee-ba2a-c4a0c5cb6eea"]
  [9486 :block/created-at 1792002820000]
  [9486 :block/order "c1Nl"]
  [9486 :block/page 314]
  [9486 :block/parent 9496]
  [9486
   :block/title
   "(a) if the activity can be done lawfully in the particular location without a planning consent; and"]
  [9486 :block/updated-at 1792002820000]
  [9486 :block/uuid #uuid "6ad2f394-5699-426f-adfd-4da5d2e3520c"]
  [9487 :block/created-at 1792002820000]
  [9487 :block/order "c1Nr"]
  [9487 :block/page 314]
  [9487 :block/parent 9490]
  [9487
   :block/title
   "(6) The authority must not issue a certificate if—"]
  [9487 :block/updated-at 1792002820000]
  [9487 :block/uuid #uuid "6ad2f394-ad85-4c6b-af8e-cf2b8984c4c1"]
  [9488 :block/created-at 1792002820000]
  [9488 :block/order "c1O0"]
  [9488 :block/page 314]
  [9488 :block/parent 9502]
  [9488
   :block/title
   "(a) contains the conditions specified in an applicable national rule; and"]
  [9488 :block/updated-at 1792002820000]
  [9488 :block/uuid #uuid "6ad2f394-8a0a-41e6-8ba3-58b0e2787633"]
  [9489 :block/created-at 1792002820000]
  [9489 :block/order "c1O4"]
  [9489 :block/page 314]
  [9489 :block/parent 9490]
  [9489
   :block/title
   "(13) In this section, activity includes a particular proposal."]
  [9489 :block/updated-at 1792002820000]
  [9489 :block/uuid #uuid "6ad2f394-dc4c-4979-8126-9c3093e54162"]
  [9490 :block/created-at 1792002820000]
  [9490 :block/order "c1Ng"]
  [9490 :block/page 314]
  [9490 :block/parent 314]
  [9490 :block/title ""]
  [9490 :block/updated-at 1792002820000]
  [9490 :block/uuid #uuid "6ad2f394-6d16-4a3b-a6ac-e57df7318e19"]
  [9491 :block/created-at 1792002820000]
  [9491 :block/order "c1O5"]
  [9491 :block/page 314]
  [9491 :block/parent 9490]
  [9491 :block/title ""]
  [9491 :block/updated-at 1792002820000]
  [9491 :block/uuid #uuid "6ad2f394-6691-4762-a10b-f43ac07a7a82"]
  [9492 :block/created-at 1792002820000]
  [9492 :block/order "c1Nh"]
  [9492 :block/page 314]
  [9492 :block/parent 9490]
  [9492
   :block/title
   "(1) A person may apply to the consent authority for a certificate of compliance in relation to an activity that can be done lawfully in a particular location without a planning consent."]
  [9492 :block/updated-at 1792002820000]
  [9492 :block/uuid #uuid "6ad2f394-018c-4113-be38-131223755e62"]
  [9493 :block/created-at 1792002820000]
  [9493 :block/order "c1Nm"]
  [9493 :block/page 314]
  [9493 :block/parent 9496]
  [9493
   :block/title
   "(b) if the person pays the appropriate administrative fee; and"]
  [9493 :block/updated-at 1792002820000]
  [9493 :block/uuid #uuid "6ad2f394-715a-4482-ac90-01fe2e535ba5"]
  [9494 :block/created-at 1792002820000]
  [9494 :block/order "c1O3"]
  [9494 :block/page 314]
  [9494 :block/parent 9490]
  [9494
   :block/title
   "(12) A certificate treated as a planning consent is subject to this Act as if it were a planning consent, except that the only sections in this Part that apply to it are sections 181 to 184, 194, and 205."]
  [9494 :block/updated-at 1792002820000]
  [9494 :block/uuid #uuid "6ad2f394-d8f3-482f-9090-56bf5681bc7d"]
  [9495 :block/created-at 1792002820000]
  [9495 :block/order "c1Nx"]
  [9495 :block/page 314]
  [9495 :block/parent 9490]
  [9495
   :block/title
   "(8) An authority that issues a certificate may, within 20 working days after the cer- tificate is issued, issue an amended certificate that corrects minor mistakes or defects in the certificate."]
  [9495 :block/updated-at 1792002820000]
  [9495 :block/uuid #uuid "6ad2f394-2635-46e8-bc20-e5b17a7ac651"]
  [9496 :block/created-at 1792002820000]
  [9496 :block/order "c1Nk"]
  [9496 :block/page 314]
  [9496 :block/parent 9490]
  [9496 :block/title "(4) The authority must issue the certificate—"]
  [9496 :block/updated-at 1792002820000]
  [9496 :block/uuid #uuid "6ad2f394-b761-4d17-9580-7a2a20d0d635"]
  [9497 :block/created-at 1792002820000]
  [9497 :block/order "c1No"]
  [9497 :block/page 314]
  [9497 :block/parent 9490]
  [9497
   :block/title
   "(5) The authority must not issue a certificate if—"]
  [9497 :block/updated-at 1792002820000]
  [9497 :block/uuid #uuid "6ad2f394-7da1-49b0-82e8-36dd8d8b1f41"]
  [9498 :block/created-at 1792002820000]
  [9498 :block/order "c1Nw"]
  [9498 :block/page 314]
  [9498 :block/parent 9512]
  [9498
   :block/title
   "(b) receiving any further information in response to a request under subsec- tion (3)."]
  [9498 :block/updated-at 1792002820000]
  [9498 :block/uuid #uuid "6ad2f394-1d1a-4df0-b529-3664c2627f64"]
  [9499 :block/created-at 1792002820000]
  [9499 :block/order "c1Nq"]
  [9499 :block/page 314]
  [9499 :block/parent 9497]
  [9499
   :block/title
   "(b) the activity could not be done lawfully in the particular location without a planning consent under the proposed plan."]
  [9499 :block/updated-at 1792002820000]
  [9499 :block/uuid #uuid "6ad2f394-856e-4d0b-b14e-b5b704403550"]
  [9500 :block/created-at 1792002820000]
  [9500 :block/order "c1Np"]
  [9500 :block/page 314]
  [9500 :block/parent 9497]
  [9500
   :block/title
   "(a) the request for a certificate is made after a proposed land use plan is notified; and"]
  [9500 :block/updated-at 1792002820000]
  [9500 :block/uuid #uuid "6ad2f394-54c0-4190-ae86-9f806a42dc9f"]
  [9501 :block/created-at 1792002820000]
  [9501 :block/order "c1Nj"]
  [9501 :block/page 314]
  [9501 :block/parent 9490]
  [9501
   :block/title
   "(3) The authority may, within 15 working days after receiving an application, require the person to provide further information if the authority considers that the information is necessary for the purpose of applying subsection (4)."]
  [9501 :block/updated-at 1792002820000]
  [9501 :block/uuid #uuid "6ad2f394-a7d4-4d75-9118-f57584e475a9"]
  [9502 :block/created-at 1792002820000]
  [9502 :block/order "c1Nz"]
  [9502 :block/page 314]
  [9502 :block/parent 9490]
  [9502
   :block/title
