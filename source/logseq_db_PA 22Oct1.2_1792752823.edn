  [13514 :block/uuid #uuid "6ad44af4-7de9-4520-bae1-58731c4a719a"]
  [13515 :block/created-at 1792297716999]
  [13515 :block/order "av"]
  [13515 :block/page 13455]
  [13515 :block/parent 13513]
  [13515
   :block/title
   "b) Avoiding housing and development where risks are assessed as ‘very high’ (see interpretation section – definition of risk levels included in the NPD via the risk matrix)."]
