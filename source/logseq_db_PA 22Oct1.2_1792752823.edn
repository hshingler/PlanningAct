  [8396 :block/updated-at 1792002820000]
  [8396 :block/uuid #uuid "6ad2f392-c37b-4cef-84e9-8a4d733bd2e6"]
  [8398 :block/created-at 1792002820000]
  [8398 :block/order "c14o"]
  [8398 :block/page 278]
  [8398 :block/parent 278]
  [8398
   :block/title
   "(1) If an application for a subdivision consent is made to a territorial authority and any part, or all, of the land proposed to be subdivided is in the coastal marine area, the territorial authority must decide the application as if the whole of that land were part of the district, and the provisions of this Act apply accordingly."]
  [8398 :block/updated-at 1792002820000]
  [8398 :block/uuid #uuid "6ad2f392-7134-4e70-9492-f4795de1e2ce"]
  [8399 :block/created-at 1792002820000]
  [8399 :block/order "c14r"]
  [8399 :block/page 278]
  [8399 :block/parent 278]
  [8399 :block/refs 444]
  [8399
   :block/title
   "(4) [Section 188]([[6ad2f38a-c2fc-467f-ac68-b55eeec7c73f]]) applies to every consent granted under subsection (3)."]
  [8399 :block/updated-at 1792002820000]
  [8399 :block/uuid #uuid "6ad2f392-0668-4bf2-a3a9-377dd484d723"]
  [8400 :block/created-at 1792002820000]
  [8400 :block/order "c14r"]
  [8400 :block/page 278]
  [8400 :block/parent 8402]
  [8400
   :block/title
   "(b) on the date that the application is made, the proposed location of the activity is still within the coastal marine area."]
  [8400 :block/updated-at 1792002820000]
  [8400 :block/uuid #uuid "6ad2f392-b48e-4b66-ad47-5e84c2260123"]
  [8402 :block/created-at 1792002820000]
  [8402 :block/order "c14p"]
  [8402 :block/page 278]
  [8402 :block/parent 278]
  [8402 :block/title "(2) Subsection (3) applies if—"]
  [8402 :block/updated-at 1792002820000]
  [8402 :block/uuid #uuid "6ad2f392-8bf5-45d5-8399-21c5bbac7274"]
  [8404 :block/created-at 1792002820000]
  [8404 :block/order "c14q"]
  [8404 :block/page 278]
  [8404 :block/parent 8402]
  [8404
   :block/title
   "(a) an application is made to a territorial authority for a planning consent for an activity that an applicant intends to undertake within the district of that authority once the proposed location of the activity has been reclaimed; and"]
  [8404 :block/updated-at 1792002820000]
  [8404 :block/uuid #uuid "6ad2f392-aa42-47ff-be3f-f3f1c573965e"]
  [8407 :block/created-at 1792002820000]
  [8407 :block/order "a0"]
  [8407 :block/page 262]
  [8407 :block/parent 8408]
  [8407 :block/title "(i) the applicant; and"]
  [8407 :block/updated-at 1792002820000]
  [8407 :block/uuid #uuid "6ad2f392-3149-471d-b27b-5c7f1205dbc8"]
  [8408 :block/created-at 1792002820000]
  [8408 :block/order "c155"]
  [8408 :block/page 262]
  [8408 :block/parent 8410]
  [8408
   :block/title
   "(a) ensure that a copy of Maritime New Zealand’s report is provided to—"]
  [8408 :block/updated-at 1792002820000]
  [8408 :block/uuid #uuid "6ad2f392-3066-4102-8a80-2557dd74a0bc"]
  [8409 :block/created-at 1792002820000]
  [8409 :block/order "c153"]
  [8409 :block/page 262]
  [8409 :block/parent 262]
  [8409
   :block/title
   "(4) If Maritime New Zealand wants to report, it must do so within 15 working days after receiving a copy of the application. If it fails to report within that time frame, the consent authority may take the failure as an indication that Maritime New Zealand has nothing to report."]
  [8409 :block/updated-at 1792002820000]
  [8409 :block/uuid #uuid "6ad2f392-4f95-496b-937d-42ef743073bb"]
  [8410 :block/created-at 1792002820000]
  [8410 :block/order "c154"]
  [8410 :block/page 262]
  [8410 :block/parent 262]
  [8410 :block/title "(5) The consent authority must—"]
  [8410 :block/updated-at 1792002820000]
  [8410 :block/uuid #uuid "6ad2f392-fc15-4333-ac1b-36f1f2560acc"]
  [8411 :block/created-at 1792002820000]
  [8411 :block/order "c150"]
  [8411 :block/page 262]
  [8411 :block/parent 262]
  [8411
   :block/title
   "(1) This section applies to an application for a land use consent to enter onto or pass across the surface of water in a navigable lake or river."]
  [8411 :block/updated-at 1792002820000]
  [8411 :block/uuid #uuid "6ad2f392-6a7b-4084-9858-0bff45c3dd34"]
  [8414 :block/created-at 1792002820000]
  [8414 :block/order "a1"]
  [8414 :block/page 262]
  [8414 :block/parent 8408]
  [8414
   :block/title
   "(ii) every person who has made a submission on the application; and"]
  [8414 :block/updated-at 1792002820000]
  [8414 :block/uuid #uuid "6ad2f392-962a-4dd6-b71f-25b82eb28c21"]
  [8415 :block/created-at 1792002820000]
  [8415 :block/order "c151"]
  [8415 :block/page 262]
  [8415 :block/parent 262]
  [8415
   :block/title
   "(2) The consent authority must send a copy of the application to Maritime New Zealand."]
  [8415 :block/updated-at 1792002820000]
  [8415 :block/uuid #uuid "6ad2f392-226d-40a1-b868-6b682ed1a452"]
  [8416 :block/created-at 1792002820000]
  [8416 :block/order "c158"]
  [8416 :block/page 262]
  [8416 :block/parent 8410]
  [8416
   :block/title
   "(b) take the report into account in its consideration of the application."]
  [8416 :block/updated-at 1792002820000]
  [8416 :block/uuid #uuid "6ad2f392-41ef-477a-91da-0acf60cec8ad"]
  [8418 :block/created-at 1792002820000]
  [8418 :block/order "c152"]
  [8418 :block/page 262]
  [8418 :block/parent 262]
  [8418
   :block/title
   "(3) Maritime New Zealand must report to the consent authority on any navigation- related matters that Maritime New Zealand considers relevant to the applica- tion, including any conditions that it considers should be included in the con- sent for navigation-related purposes."]
  [8418 :block/updated-at 1792002820000]
  [8418 :block/uuid #uuid "6ad2f392-0c61-4b99-9ab6-97631f72b469"]
  [8422 :block/created-at 1792002820000]
  [8422 :block/order "c15G"]
  [8422 :block/page 396]
  [8422 :block/parent 8424]
  [8422
   :block/title
   "(a) the person must comply with section 62A of the Marine and Coastal Area (Takutai Moana) Act 2011 (which requires the person to notify applicant groups, provide a list of the groups notified, and record their views); and"]
  [8422 :block/updated-at 1792002820000]
  [8422 :block/uuid #uuid "6ad2f392-4586-4b6d-a76d-28bc4c0a462c"]
  [8423 :block/created-at 1792002820000]
  [8423 :block/order "c15G"]
  [8423 :block/page 396]
  [8423 :block/parent 396]
  [8423 :block/refs 228]
  [8423
   :block/title
   "(2) In this section, applicant group has the meaning given to it by [section 9]([[6ad2f38a-4653-48a8-9680-87d09cfa1939]])(1) of the Marine and Coastal Area (Takutai Moana) Act 2011."]
  [8423 :block/updated-at 1792002820000]
  [8423 :block/uuid #uuid "6ad2f392-8c84-4628-8a88-c97647de0d12"]
  [8424 :block/created-at 1792002820000]
  [8424 :block/order "c15F"]
  [8424 :block/page 396]
  [8424 :block/parent 396]
  [8424
   :block/title
   "(1) If a person applies for a planning consent relating to an area where an applicant group seeks customary marine title,—"]
  [8424 :block/updated-at 1792002820000]
  [8424 :block/uuid #uuid "6ad2f392-85d2-4c3d-bbc5-e0ee9f80d9e0"]
  [8426 :block/created-at 1792002820000]
  [8426 :block/order "c15H"]
  [8426 :block/page 396]
  [8426 :block/parent 8424]
  [8426 :block/refs 302]
  [8426
   :block/title
   "(b) the application must be treated as incomplete under [section 139]([[6ad2f38a-81cb-4bc5-9306-d79df8c93a8f]]) if this is not done."]
  [8426 :block/updated-at 1792002820000]
  [8426 :block/uuid #uuid "6ad2f392-4b94-44f9-869d-8a43bbe7da7c"]
  [8428 :block/created-at 1792209810850]
  [8428 :block/order "c15T"]
  [8428 :block/page 475]
  [8428 :block/parent 475]
  [8428 :block/title ""]
  [8428 :block/updated-at 1792209810850]
  [8428 :block/uuid #uuid "6ad2f392-b6ce-40eb-893b-a09d1af259ad"]
  [8432 :block/created-at 1792002820000]
  [8432 :block/order "c15P"]
  [8432 :block/page 475]
  [8432 :block/parent 475]
  [8432
   :block/title
   "(1) If a person applies for a planning consent for any ORE generation infrastruc- ture activities (excluding decommissioning activities),—"]
  [8432 :block/updated-at 1792002820000]
  [8432 :block/uuid #uuid "6ad2f392-ec97-4d84-8f7b-05d2576f5dd3"]
  [8433 :block/created-at 1792002820000]
  [8433 :block/order "c15Q"]
  [8433 :block/page 475]
  [8433 :block/parent 8432]
  [8433
   :block/title
   "(a) the applicant must be the permit holder of a current feasibility permit or commercial permit granted under the Offshore Renewable Energy Act 2026 that applies to the area to which it is proposed that the planning consent will apply; and"]
  [8433 :block/updated-at 1792002820000]
  [8433 :block/uuid #uuid "6ad2f392-34ce-47af-a7f7-bf591a47433c"]
  [8434 :block/created-at 1792002820000]
  [8434 :block/order "c15R"]
  [8434 :block/page 475]
  [8434 :block/parent 8432]
  [8434
   :block/title
   "(b) the applicant must include the details of the feasibility permit or com- mercial permit in the application."]
  [8434 :block/updated-at 1792002820000]
  [8434 :block/uuid #uuid "6ad2f392-710f-44f2-a70b-efc90a82263c"]
  [8435 :block/created-at 1792002820000]
  [8435 :block/order "c15Q"]
  [8435 :block/page 475]
  [8435 :block/parent 475]
  [8435
   :block/title
   "(2) A consent authority may, at any time, determine that the application is incom- plete if the applicant does not comply with subsection (1)."]
  [8435 :block/updated-at 1792002820000]
  [8435 :block/uuid #uuid "6ad2f392-a5a1-4a40-817c-cb13500e685e"]
  [8437 :block/created-at 1792002820000]
  [8437 :block/order "c15Y"]
  [8437 :block/page 302]
  [8437 :block/parent 302]
  [8437 :block/refs 201]
  [8437
   :block/title
   "(1) A consent authority may, within 10 working days after an application is lodged, determine that an application is incomplete if the application does not include the information required by [section 132]([[6ad2f38a-2d74-463e-9e21-47fd58d3e681]])(2)."]
  [8437 :block/updated-at 1792002820000]
  [8437 :block/uuid #uuid "6ad2f392-d91b-454b-b273-a56ef312a5b0"]
  [8439 :block/created-at 1792002820000]
  [8439 :block/order "c15Z"]
  [8439 :block/page 302]
  [8439 :block/parent 302]
  [8439
   :block/title
   "(2) If the consent authority decides that the application is incomplete, it must immediately return the application to the applicant with written reasons for the decision."]
  [8439 :block/updated-at 1792002820000]
  [8439 :block/uuid #uuid "6ad2f392-7624-41a3-97c3-ce9d7f55a660"]
  [8441 :block/created-at 1792002820000]
  [8441 :block/order "c15a"]
  [8441 :block/page 302]
  [8441 :block/parent 302]
  [8441
   :block/title
   "(3) A person may apply to the Planning Tribunal to review a decision that an appli- cation is incomplete."]
  [8441 :block/updated-at 1792002820000]
  [8441 :block/uuid #uuid "6ad2f392-f017-4e86-8809-4e7310fb6362"]
  [8442 :block/created-at 1792002820000]
  [8442 :block/order "c15b"]
  [8442 :block/page 302]
  [8442 :block/parent 302]
  [8442
   :block/title
   "(4) If an application that has been returned under this section is lodged again with the consent authority, that application must be treated as a new application."]
  [8442 :block/updated-at 1792002820000]
  [8442 :block/uuid #uuid "6ad2f392-f772-42f1-81a9-33185a0766a6"]
  [8445 :block/created-at 1792209810878]
  [8445 :block/order "c15z"]
  [8445 :block/page 433]
  [8445 :block/parent 433]
  [8445 :block/title ""]
  [8445 :block/updated-at 1792209810878]
  [8445 :block/uuid #uuid "6ad2f392-2943-418a-8820-8190cd8342ca"]
  [8446 :block/created-at 1792002820000]
  [8446 :block/order "c15p"]
  [8446 :block/page 433]
  [8446 :block/parent 8447]
  [8446
   :block/title
   "(b) must implement an instrument higher up the list if required by that instrument."]
  [8446 :block/updated-at 1792002820000]
  [8446 :block/uuid #uuid "6ad2f392-5521-4667-8ce4-83adcfee1441"]
  [8447 :block/created-at 1792002820000]
  [8447 :block/order "c15h8"]
  [8447 :block/page 433]
  [8447 :block/parent 433]
  [8447
   :block/title
   "(2) Each key instrument (other than the national policy direction)—"]
  [8447 :block/updated-at 1792002820000]
  [8447 :block/uuid #uuid "6ad2f392-9bc8-4b79-97e6-9414a17f7b8e"]
  [8449 :block/created-at 1792002820000]
  [8449 :block/order "c15t"]
  [8449 :block/page 433]
  [8449 :block/parent 8451]
  [8449
   :block/title
   "(c) must not consider a goal directly unless and to the extent that they are satisfied that—"]
  [8449 :block/updated-at 1792002820000]
  [8449 :block/uuid #uuid "6ad2f392-db5f-4f63-89be-9a6e3c1c4ec6"]
  [8450 :block/created-at 1792002820000]
  [8450 :block/order "c15h4"]
  [8450 :block/page 433]
  [8450 :block/parent 433]
  [8450
   :block/title
   "(1) The hierarchy of the key instruments of this Act is as follows, listed from top to bottom:"]
  [8450 :block/updated-at 1792002820000]
  [8450 :block/uuid #uuid "6ad2f392-dca4-4253-9533-36c881bbad77"]
  [8451 :block/created-at 1792002820000]
  [8451 :block/order "c15hG"]
  [8451 :block/page 433]
  [8451 :block/parent 433]
  [8451
   :block/title
   "(3) A person exercising or performing a function, power, or duty under this Act in relation to a matter—"]
  [8451 :block/updated-at 1792002820000]
  [8451 :block/uuid #uuid "6ad2f392-15f6-4e0c-88e1-34a1f9d1810b"]
  [8452 :block/created-at 1792002820000]
  [8452 :block/order "c15hV"]
  [8452 :block/page 433]
  [8452 :block/parent 433]
  [8452
   :block/title
   "(4) Subsection (3) does not apply to the making of national policy direction."]
  [8452 :block/updated-at 1792002820000]
  [8452 :block/uuid #uuid "6ad2f392-86f2-470d-bbd9-b06722dca349"]
  [8453 :block/created-at 1792002820000]
  [8453 :block/order "c15j"]
  [8453 :block/page 433]
  [8453 :block/parent 8450]
  [8453 :block/title "(a) national policy direction:"]
  [8453 :block/updated-at 1792002820000]
  [8453 :block/uuid #uuid "6ad2f392-210a-4893-8acc-23ff544d1291"]
  [8454 :block/created-at 1792002820000]
  [8454 :block/order "c15s"]
  [8454 :block/page 433]
  [8454 :block/parent 8451]
  [8454
   :block/title
   "(b) must consider any relevant provisions of a higher order instrument if, and only to the extent that, the matter is not addressed by the instrument listed beneath it; and"]
  [8454 :block/updated-at 1792002820000]
  [8454 :block/uuid #uuid "6ad2f392-f120-42c5-b76e-a055aa1883ac"]
  [8456 :block/created-at 1792002820000]
  [8456 :block/order "c15m"]
  [8456 :block/page 433]
  [8456 :block/parent 8450]
  [8456 :block/title "(d) land use plans."]
  [8456 :block/updated-at 1792002820000]
  [8456 :block/uuid #uuid "6ad2f392-30d2-46cc-a28a-49eba9c9e7e8"]
  [8457 :block/created-at 1792002820000]
  [8457 :block/order "c15u"]
  [8457 :block/page 433]
  [8457 :block/parent 8451]
  [8457
   :block/title
   "(i) the subject matter of the goal is not addressed in a higher order instrument; or"]
  [8457 :block/updated-at 1792002820000]
  [8457 :block/uuid #uuid "6ad2f392-a6b5-4663-a9f2-bc4ded579d80"]
  [8458 :block/created-at 1792002820000]
  [8458 :block/order "c15o"]
  [8458 :block/page 433]
  [8458 :block/parent 8447]
  [8458
   :block/title
   "(a) must implement the instrument listed directly above it; and"]
  [8458 :block/updated-at 1792002820000]
  [8458 :block/uuid #uuid "6ad2f392-bf44-48e2-9c16-625e1f265fd8"]
  [8459 :block/created-at 1792002820000]
  [8459 :block/order "c15i"]
  [8459 :block/page 433]
  [8459 :block/parent 433]
  [8459
   :block/title
   "(5) In this section, a higher order instrument means any key instrument that is listed above the instrument that directly affects the matter."]
  [8459 :block/updated-at 1792002820000]
  [8459 :block/uuid #uuid "6ad2f392-6099-41e5-8ac9-6a0de097f599"]
  [8460 :block/created-at 1792002820000]
  [8460 :block/order "c15r"]
  [8460 :block/page 433]
  [8460 :block/parent 8451]
  [8460
   :block/title
   "(a) must consider the relevant provisions of the key instrument that directly affects the matter (for example, a spatial plan in the case of a land use plan); and"]
  [8460 :block/updated-at 1792002820000]
  [8460 :block/uuid #uuid "6ad2f392-fac6-4e4c-a59f-7655d55677fd"]
  [8462 :block/created-at 1792002820000]
  [8462 :block/order "c15l"]
  [8462 :block/page 433]
  [8462 :block/parent 8450]
  [8462 :block/title "(c) regional spatial plans:"]
  [8462 :block/updated-at 1792002820000]
  [8462 :block/uuid #uuid "6ad2f392-4171-4000-9a35-4b2d22706f8e"]
  [8463 :block/created-at 1792002820000]
  [8463 :block/order "c15k"]
  [8463 :block/page 433]
  [8463 :block/parent 8450]
  [8463 :block/title "(b) national standards:"]
  [8463 :block/updated-at 1792002820000]
  [8463 :block/uuid #uuid "6ad2f392-af10-415f-a727-b0d039bbdced"]
  [8464 :block/created-at 1792002820000]
  [8464 :block/order "c15w"]
  [8464 :block/page 433]
  [8464 :block/parent 8457]
  [8464
   :block/title
   "(iii) there is irreconcilable conflict between higher order instruments in relation to the goal."]
  [8464 :block/updated-at 1792002820000]
  [8464 :block/uuid #uuid "6ad2f392-5f53-46fd-b131-2a57fd46102b"]
  [8465 :block/created-at 1792002820000]
  [8465 :block/order "c15v"]
  [8465 :block/page 433]
  [8465 :block/parent 8457]
  [8465
   :block/title
   "(ii) there is significant uncertainty within a higher order instrument in relation to the goal; or"]
  [8465 :block/updated-at 1792002820000]
  [8465 :block/uuid #uuid "6ad2f392-23a9-4ccd-9fd0-cbe36c584e6e"]
  [8467 :block/created-at 1792002820000]
  [8467 :block/order "c164"]
  [8467 :block/page 495]
  [8467 :block/parent 495]
  [8467
   :block/title
   "(1) A consent authority may determine not to proceed with the notification or hear- ing of an application for a planning consent if it considers on reasonable grounds that—"]
  [8467 :block/updated-at 1792002820000]
  [8467 :block/uuid #uuid "6ad2f392-94fa-48dc-8a59-75f7285ebc67"]
  [8468 :block/created-at 1792002820000]
  [8468 :block/order "c166"]
  [8468 :block/page 495]
  [8468 :block/parent 495]
  [8468
   :block/title
   "(3) The determination does not affect whether notification or hearing of the appli- cation is required."]
  [8468 :block/updated-at 1792002820000]
  [8468 :block/uuid #uuid "6ad2f392-8498-4956-963e-7e6750a84e71"]
  [8470 :block/created-at 1792002820000]
  [8470 :block/order "c168"]
  [8470 :block/page 495]
  [8470 :block/parent 8471]
  [8470 :block/title "(a) make a determination under subsection (1)—"]
  [8470 :block/updated-at 1792002820000]
  [8470 :block/uuid #uuid "6ad2f392-4e73-48be-b33a-72aad2acf0ff"]
  [8471 :block/created-at 1792002820000]
  [8471 :block/order "c165"]
  [8471 :block/page 495]
  [8471 :block/parent 495]
  [8471 :block/title "(2) The consent authority must—"]
  [8471 :block/updated-at 1792002820000]
  [8471 :block/uuid #uuid "6ad2f392-b748-44da-99f4-557c5a530b36"]
  [8472 :block/created-at 1792002820000]
  [8472 :block/order "c169"]
  [8472 :block/page 495]
  [8472 :block/parent 8471]
  [8472 :block/refs 501]
  [8472
   :block/title
   "(i) before it decides whether to give public or targeted notification, or decides to not notify, an application for a planning consent under [section 147]([[6ad2f38a-38a7-4ffe-ba14-946821d5b865]]); and"]
  [8472 :block/updated-at 1792002820000]
  [8472 :block/uuid #uuid "6ad2f392-3767-4a43-8413-60f96b0770d4"]
  [8474 :block/created-at 1792002820000]
  [8474 :block/order "c166"]
  [8474 :block/page 495]
  [8474 :block/parent 8467]
  [8474
   :block/title
   "(b) it is appropriate, for the purpose of better understanding the nature of the proposal, that applications for any 1 or more of those other planning consents be made before proceeding further."]
  [8474 :block/updated-at 1792002820000]
  [8474 :block/uuid #uuid "6ad2f392-eb44-405d-8cd3-49c50b3d3441"]
  [8476 :block/created-at 1792002820000]
  [8476 :block/order "c16B"]
  [8476 :block/page 495]
  [8476 :block/parent 8471]
  [8476 :block/title "(b) notify the applicant of the determination."]
  [8476 :block/updated-at 1792002820000]
  [8476 :block/uuid #uuid "6ad2f392-065f-4081-a1a3-694142ef4869"]
  [8478 :block/created-at 1792002820000]
  [8478 :block/order "c165"]
  [8478 :block/page 495]
