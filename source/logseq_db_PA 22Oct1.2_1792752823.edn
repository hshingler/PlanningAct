  [8661 :block/page 352]
  [8661 :block/parent 8663]
  [8661
   :block/title
   "(b) if the activity is a restricted discretionary activity, must disregard an adverse effect of the activity on the person if the effect does not relate to a matter for which a rule in a land use plan or a national rule has reserved discretion; and"]
  [8661 :block/updated-at 1792002820000]
  [8661 :block/uuid #uuid "6ad2f393-c623-4b30-9d1f-c1e02e10a85d"]
  [8662 :block/created-at 1792002820000]
  [8662 :block/order "c19L"]
  [8662 :block/page 352]
  [8662 :block/parent 8663]
  [8662
   :block/title
   "(a) must disregard an adverse effect of the activity on the person if a rule in a land use plan or a national rule permits an activity with that effect; and"]
  [8662 :block/updated-at 1792002820000]
  [8662 :block/uuid #uuid "6ad2f393-fd07-4249-84bd-0e21682040c9"]
  [8663 :block/created-at 1792002820000]
  [8663 :block/order "c19G"]
  [8663 :block/page 352]
  [8663 :block/parent 352]
  [8663
   :block/title
   "(2) When assessing whether an activity’s adverse effects on a person are more than minor, the consent authority—"]
