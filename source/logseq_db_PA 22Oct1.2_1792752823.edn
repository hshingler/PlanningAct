  [9451 :block/order "c1NA"]
  [9451 :block/page 235]
  [9451 :block/parent 9456]
  [9451
   :block/title
   "(b) affect the ability of the consent holder to meet other conditions of the consent; or"]
  [9451 :block/updated-at 1792002820000]
  [9451 :block/uuid #uuid "6ad2f394-84ef-43e9-b300-49501ccbd300"]
  [9452 :block/created-at 1792002820000]
  [9452 :block/order "c1N7"]
  [9452 :block/page 235]
  [9452 :block/parent 9460]
  [9452
   :block/title
   "(1) The consent holder may surrender the consent, either in whole or in part, by giving written notice to the consent authority."]
  [9452 :block/updated-at 1792002820000]
  [9452 :block/uuid #uuid "6ad2f394-2501-4886-a090-b19dcb317b1d"]
  [9453 :block/created-at 1792002820000]
  [9453 :block/order "c1NB"]
  [9453 :block/page 235]
  [9453 :block/parent 9456]
  [9453
   :block/title
   "(c) lead to an adverse effect on the built environment."]
  [9453 :block/updated-at 1792002820000]
  [9453 :block/uuid #uuid "6ad2f394-8e5a-47d9-8411-1f8a9e8b1d62"]
  [9454 :block/created-at 1792002820000]
  [9454 :block/order "c1NH"]
  [9454 :block/page 235]
  [9454 :block/parent 235]
  [9454
   :block/title
   "Subpart 7—Miscellaneous Processes relating to activities that do not require planning consent"]
  [9454 :block/updated-at 1792002820000]
  [9454 :block/uuid #uuid "6ad2f394-37e2-4fc7-8558-ac8bb99ffdc8"]
  [9455 :block/created-at 1792002820000]
  [9455 :block/order "c1NE"]
  [9455 :block/page 235]
  [9455 :block/parent 9459]
  [9455
   :block/title
   "(b) to complete any work to give effect to the consent unless the consent authority directs otherwise in its notice of acceptance of the surrender."]
  [9455 :block/updated-at 1792002820000]
  [9455 :block/uuid #uuid "6ad2f394-98b2-43de-89d7-2df850a354af"]
  [9456 :block/created-at 1792002820000]
  [9456 :block/order "c1N8"]
  [9456 :block/page 235]
  [9456 :block/parent 9460]
  [9456
   :block/title
   "(2) A consent authority may refuse to accept the surrender of part of a planning consent if it considers that the surrender of that part would—"]
  [9456 :block/updated-at 1792002820000]
  [9456 :block/uuid #uuid "6ad2f394-94e1-4e07-a365-aacdf15fa5a7"]
  [9457 :block/created-at 1792002820000]
  [9457 :block/order "c1N4"]
  [9457 :block/page 235]
  [9457 :block/parent 235]
  [9457 :block/title ""]
  [9457 :block/updated-at 1792002820000]
  [9457 :block/uuid #uuid "6ad2f394-bdb9-41aa-beb6-1ca83d49e0c7"]
  [9458 :block/created-at 1792002820000]
  [9458 :block/order "c1N9"]
  [9458 :block/page 235]
  [9458 :block/parent 9456]
  [9458 :block/title "(a) affect the integrity of the consent; or"]
  [9458 :block/updated-at 1792002820000]
  [9458 :block/uuid #uuid "6ad2f394-33cd-4057-9c1c-cbe03bda7045"]
  [9459 :block/created-at 1792002820000]
  [9459 :block/order "c1NC"]
  [9459 :block/page 235]
  [9459 :block/parent 9460]
  [9459
   :block/title
   "(3) A person who surrenders a planning consent remains liable under this Act—"]
  [9459 :block/updated-at 1792002820000]
  [9459 :block/uuid #uuid "6ad2f394-2917-4d50-8f1d-b7eca01c9863"]
  [9460 :block/created-at 1792002820000]
  [9460 :block/order "c1N6"]
  [9460 :block/page 235]
  [9460 :block/parent 235]
  [9460 :block/title ""]
  [9460 :block/updated-at 1792002820000]
  [9460 :block/uuid #uuid "6ad2f394-1dfe-4930-b510-1800a950cd6e"]
  [9461 :block/created-at 1792002820000]
  [9461 :block/order "c1NG"]
  [9461 :block/page 235]
  [9461 :block/parent 9460]
  [9461 :block/title ""]
  [9461 :block/updated-at 1792002820000]
  [9461 :block/uuid #uuid "6ad2f394-cecb-4676-9682-f6dd8721adc4"]
  [9462 :block/created-at 1792002820000]
  [9462 :block/order "c1NF"]
  [9462 :block/page 235]
  [9462 :block/parent 9460]
  [9462
   :block/title
   "(4) A surrender of a planning consent takes effect on receipt by the consent holder of a notice of acceptance of the surrender from the consent authority."]
  [9462 :block/updated-at 1792002820000]
  [9462 :block/uuid #uuid "6ad2f394-2363-4567-a5db-c3aa41926fae"]
  [9463 :block/created-at 1792002820000]
  [9463 :block/order "c1N5"]
  [9463 :block/page 235]
  [9463 :block/parent 235]
  [9463 :block/refs 503]
  [9463 :block/title ""]
