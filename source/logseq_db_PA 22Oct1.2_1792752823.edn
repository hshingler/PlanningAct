  [9037 :block/uuid #uuid "6ad2f393-b229-439d-9194-49591c2ae78a"]
  [9038 :block/created-at 1792002820000]
  [9038 :block/order "c1Fu"]
  [9038 :block/page 450]
  [9038 :block/parent 9040]
  [9038
   :block/title
   "(ii) is more stringent than the water services standard."]
  [9038 :block/updated-at 1792002820000]
  [9038 :block/uuid #uuid "6ad2f393-7c3b-4648-8872-e4626dd8608c"]
  [9040 :block/created-at 1792002820000]
  [9040 :block/order "c1Ft"]
  [9040 :block/page 450]
  [9040 :block/parent 9037]
  [9040
   :block/title
   "(i) is included in a land use plan or proposed land use plan to give effect to Te Ture Whaimana o Te Awa o Waikato—the Vision and Strategy for the Waikato River; and"]
  [9040 :block/updated-at 1792002820000]
  [9040 :block/uuid #uuid "6ad2f393-dd47-475b-877d-94eb1f481c32"]
  [9041 :block/created-at 1792002820000]
  [9041 :block/order "c1Fs"]
  [9041 :block/page 450]
  [9041 :block/parent 9037]
  [9041 :block/title "(b) a provision that—"]
  [9041 :block/updated-at 1792002820000]
  [9041 :block/uuid #uuid "6ad2f393-46e0-4b15-a092-527121613c72"]
  [9044 :block/created-at 1792209811625]
  [9044 :block/order "c1GJ"]
  [9044 :block/page 536]
  [9044 :block/parent 536]
  [9044 :block/title ""]
  [9044 :block/updated-at 1792209811625]
  [9044 :block/uuid #uuid "6ad2f393-20d9-408c-bf30-0273be08bd0d"]
  [9045 :block/created-at 1792002820000]
  [9045 :block/order "c1G6"]
  [9045 :block/page 536]
  [9045 :block/parent 536]
  [9045
   :block/title
