  [9157 :block/created-at 1792002820000]
  [9157 :block/order "c1Hz"]
  [9157 :block/page 467]
  [9157 :block/parent 9156]
  [9157
   :block/title
   "(c) subject to the provisions of this Act, and in particular to subsection (3)."]
  [9157 :block/updated-at 1792002820000]
