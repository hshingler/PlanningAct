  [7815 :block/order "c0kQ"]
  [7815 :block/page 913]
  [7815 :block/parent 7544]
  [7815
   :block/title
   "(b) undertake any other paid employment or hold any other office (whether paid or not) without the approval of the Chief Environment Court Judge."]
  [7815 :block/updated-at 1792002820000]
  [7815 :block/uuid #uuid "6ad2f391-4b47-449d-b553-9097c2183d53"]
