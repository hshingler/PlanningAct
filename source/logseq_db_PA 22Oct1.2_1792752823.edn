   "INFR-Directive 2.4: To enable the renewable energy system to be significantly developed and expanded, land use plans and natural environment plans must:"]
  [13568 :block/updated-at 1792297900443]
  [13568 :block/uuid #uuid "6ad44bac-9a4c-48e7-a6c3-4739b25aa5ff"]
  [13569 :block/created-at 1792297900443]
  [13569 :block/order "aq"]
  [13569 :block/page 13517]
  [13569 :block/parent 13568]
  [13569
   :block/title
   "a) Recognise and provide for the national, regional and local benefits of energy infrastructure."]
  [13569 :block/updated-at 1792297900443]
  [13569 :block/uuid #uuid "6ad44bac-04f4-4b37-a13c-5e6939f55a04"]
  [13570 :block/created-at 1792297900443]
  [13570 :block/order "ar"]
  [13570 :block/page 13517]
  [13570 :block/parent 13568]
  [13570
   :block/title
