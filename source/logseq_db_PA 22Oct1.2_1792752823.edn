  [9158 :block/created-at 1792002820000]
  [9158 :block/order "c1HpV"]
  [9158 :block/page 467]
  [9158 :block/parent 467]
  [9158
   :block/title
   "(3) The consent holder may grant a security interest over the consent as if it were personal property, but the consent may only be transferred to the secured party, or by or on behalf of the secured party, to the same extent as it could be so transferred by the holder."]
  [9158 :block/updated-at 1792002820000]
  [9158 :block/uuid #uuid "6ad2f393-6154-44ed-8c14-b5bba63cfa5f"]
  [9160 :block/created-at 1792002820000]
  [9160 :block/order "c1Hs"]
  [9160 :block/page 467]
  [9160 :block/parent 9163]
  [9160
   :block/title
