  [12948 :block/uuid #uuid "6ad2f398-9427-4591-a37a-98cb6233abb8"]
  [12950 :block/created-at 1792002820000]
  [12950 :block/order "c2L2"]
  [12950 :block/page 337]
  [12950 :block/parent 12956]
  [12950
   :block/title
   "(c) be published by the territorial authority in the manner prescribed by regulations."]
  [12950 :block/updated-at 1792002820000]
  [12950 :block/uuid #uuid "6ad2f398-5d3b-43b9-9758-cb2acc4bed7e"]
