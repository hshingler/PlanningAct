  [8683 :block/uuid #uuid "6ad2f393-4e96-4d51-828f-494c1059de14"]
  [8686 :block/created-at 1792002820000]
  [8686 :block/order "c19o"]
  [8686 :block/page 351]
  [8686 :block/parent 8683]
  [8686
   :block/title
   "(a) a qualifying person of the district to which the application relates:"]
  [8686 :block/updated-at 1792002820000]
  [8686 :block/uuid #uuid "6ad2f393-3692-482c-9ef4-700caba80717"]
  [8687 :block/created-at 1792002820000]
  [8687 :block/order "c19r"]
  [8687 :block/page 351]
  [8687 :block/parent 8691]
  [8687
   :block/title
   "(a) a qualifying person of the region to which the application relates:"]
  [8687 :block/updated-at 1792002820000]
  [8687 :block/uuid #uuid "6ad2f393-1ae2-477f-b392-f1495946abef"]
  [8690 :block/created-at 1792002820000]
  [8690 :block/order "c19p"]
  [8690 :block/page 351]
  [8690 :block/parent 351]
  [8690
   :block/title
   "(3) If targeted notification is given for an application for a planning consent, a per- son served with notice of the application may make a submission about it to the consent authority."]
  [8690 :block/updated-at 1792002820000]
  [8690 :block/uuid #uuid "6ad2f393-b16b-423b-8491-b9fcbd07916f"]
  [8691 :block/created-at 1792002820000]
  [8691 :block/order "c19o"]
  [8691 :block/page 351]
  [8691 :block/parent 351]
  [8691 :block/refs 336]
  [8691
   :block/title
   "(2) If public notification is given for an application for a planning consent in rela- tion to an activity for which the consent authority is the regional council under [section 217]([[6ad2f38a-10b4-42f6-ac75-8b36c08160fa]]), the following persons may make a submission about it to the con- sent authority:"]
  [8691 :block/updated-at 1792002820000]
  [8691 :block/uuid #uuid "6ad2f393-a0cd-49da-b30d-1d40acfb1f2e"]
  [8692 :block/created-at 1792002820000]
  [8692 :block/order "c19p"]
  [8692 :block/page 351]
  [8692 :block/parent 8683]
  [8692 :block/refs 352]
  [8692
   :block/title
   "(b) a person who is not a qualifying person of the district to which the appli- cation relates if that person is an affected person under [section 151]([[6ad2f38a-8071-4405-91aa-f40c90167b78]])."]
  [8692 :block/updated-at 1792002820000]
  [8692 :block/uuid #uuid "6ad2f393-8b45-480b-9738-f78f31e7d839"]
  [8693 :block/created-at 1792002820000]
  [8693 :block/order "c19s"]
  [8693 :block/page 351]
  [8693 :block/parent 8691]
  [8693 :block/refs 352]
  [8693
   :block/title
   "(b) a person who is not a qualifying person of the region to which the appli- cation relates if that person is an affected person under [section 151]([[6ad2f38a-8071-4405-91aa-f40c90167b78]])."]
  [8693 :block/updated-at 1792002820000]
  [8693 :block/uuid #uuid "6ad2f393-8620-4b76-9d8d-7d6612ceff21"]
  [8695 :block/created-at 1792002820000]
  [8695 :block/order "c1A1"]
  [8695 :block/page 248]
  [8695 :block/parent 8702]
  [8695
   :block/title
   "(a) be made in the manner prescribed in regulations; and"]
  [8695 :block/updated-at 1792002820000]
  [8695 :block/uuid #uuid "6ad2f393-4980-4a07-b742-c1c9e4085aee"]
  [8696 :block/created-at 1792002820000]
  [8696 :block/order "c1A2"]
  [8696 :block/page 248]
  [8696 :block/parent 8702]
