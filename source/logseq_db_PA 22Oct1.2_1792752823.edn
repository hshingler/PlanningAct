  [12169 :block/parent 494]
  [12169
   :block/title
   "(1) A designation or a construction project plan may be more enabling than a national rule—"]
  [12169 :block/updated-at 1792002820000]
  [12169 :block/uuid #uuid "6ad2f397-c4e7-4c5b-b6ee-9c868c4bebb1"]
  [12170 :block/created-at 1792002820000]
