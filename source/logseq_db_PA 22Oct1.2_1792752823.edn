  [12947 :block/order "c2L4"]
  [12947 :block/page 337]
  [12947 :block/parent 12945]
  [12947
   :block/title
   "(a) a reference to the local authorities of a region, in relation to the prepar- ation, consideration, or adoption of the relevant draft, does not include the territorial authority:"]
