  [12163 :block/updated-at 1792002820000]
  [12163 :block/uuid #uuid "6ad2f397-9a5e-4d86-82df-14ffc568ebac"]
  [12164 :block/created-at 1792002820000]
  [12164 :block/order "c27w"]
  [12164 :block/page 494]
  [12164 :block/parent 12163]
  [12164 :block/title "(c) the designation is applied to the work."]
  [12164 :block/updated-at 1792002820000]
  [12164 :block/uuid #uuid "6ad2f397-3c97-48ad-96a0-6beaff93b524"]
  [12165 :block/created-at 1792002820000]
  [12165 :block/order "c27q"]
  [12165 :block/page 494]
  [12165 :block/parent 12170]
  [12165 :block/title "(c) the national rule is made—"]
