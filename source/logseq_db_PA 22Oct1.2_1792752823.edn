   "(a) the applicant has agreed to the condition; or"]
  [9061 :block/updated-at 1792002820000]
  [9061 :block/uuid #uuid "6ad2f393-8cd8-4e35-b1c8-bba4597432d1"]
  [9063 :block/created-at 1792002820000]
  [9063 :block/order "a0"]
  [9063 :block/page 536]
  [9063 :block/parent 9045]
  [9063 :block/title ""]
