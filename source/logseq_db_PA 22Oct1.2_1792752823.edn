  [12155 :block/uuid #uuid "6ad2f397-0727-4ea4-a8cf-f08fbd0a585c"]
  [12156 :block/created-at 1792002820000]
  [12156 :block/order "c27O"]
  [12156 :block/page 331]
  [12156 :block/parent 12155]
  [12156
   :block/title
   "(a) is granted under a rule in a land use plan or proposed land use plan that has legal effect; and"]
