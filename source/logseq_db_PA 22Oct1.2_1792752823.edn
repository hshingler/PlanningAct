  [12908 :block/created-at 1792002820000]
  [12908 :block/order "c2KH"]
  [12908 :block/page 228]
  [12908 :block/parent 12903]
  [12908
   :block/title
   "(b) following those discussions, and where agreement is reached, enter into the agreement with the entity or ngā hapū o Ngāti Porou to record that agreement reached (which may include entering into a deed to amend the relevant Treaty settlement deed)."]
  [12908 :block/updated-at 1792002820000]
  [12908 :block/uuid #uuid "6ad2f398-ff24-4a0f-bba2-7dae660fbf92"]
  [12911 :block/created-at 1792002820000]
  [12911 :block/order "c2KK"]
  [12911 :block/page 228]
  [12911 :block/parent 12907]
  [12911
   :block/title
   "(a) continuing discussions with any post-settlement governance entity, or ngā hapū o Ngāti Porou, for the purpose of reaching an agreement as to how their Treaty settlement redress or arrangement could operate with the same or equivalent effect, to the greatest extent possible under this Act and the Natural Environment Act 2026, to the effect that the redress or arrangement had under the Resource Management Act 1991; or"]
  [12911 :block/updated-at 1792002820000]
  [12911 :block/uuid #uuid "6ad2f398-7b39-47ba-bc94-1fd09f6b61e4"]
  [12912 :block/created-at 1792002820000]
  [12912 :block/order "c2KM"]
  [12912 :block/page 228]
  [12912 :block/parent 12907]
  [12912
   :block/title
   "(c) progressing any legislation necessary to give effect to that agreement."]
  [12912 :block/updated-at 1792002820000]
  [12912 :block/uuid #uuid "6ad2f398-9c8c-44d0-a5a2-11f7c7c926ce"]
  [12913 :block/created-at 1792002820000]
  [12913 :block/order "c2KL"]
  [12913 :block/page 228]
  [12913 :block/parent 12907]
  [12913
   :block/title
   "(b) entering into an agreement with the entity or ngā hapū o Ngāti Porou; or"]
  [12913 :block/updated-at 1792002820000]
  [12913 :block/uuid #uuid "6ad2f398-5f78-4ef9-8dce-5d6b7098da56"]
  [12916 :block/created-at 1792002820000]
  [12916 :block/order "c2KU"]
  [12916 :block/page 265]
  [12916 :block/parent 265]
