  [12157 :block/uuid #uuid "6ad2f397-41ed-46ed-9042-3e0664838cca"]
  [12159 :block/created-at 1792002820000]
  [12159 :block/order "a0"]
  [12159 :block/page 331]
  [12159 :block/parent 12154]
  [12159 :block/title ""]
  [12159 :block/updated-at 1792002820000]
  [12159 :block/uuid #uuid "6ad2f397-e3bb-44ba-8061-323999f38bd9"]
  [12160 :block/created-at 1792002820000]
  [12160 :block/order "c27L"]
  [12160 :block/page 331]
  [12160 :block/parent 331]
  [12160
   :block/title
   "(1) A planning consent that is more restrictive than a national rule prevails over the rule if the rule expressly allows a planning consent to be more restrictive than it."]
  [12160 :block/updated-at 1792002820000]
  [12160 :block/uuid #uuid "6ad2f397-4dc3-423d-baa1-1bc7ad93be72"]
  [12162 :block/created-at 1792209815785]
  [12162 :block/order "c27z"]
