  [10703 :block/updated-at 1792002820000]
  [10703 :block/uuid #uuid "6ad2f395-7eeb-428b-a952-fd4069e3ab27"]
  [10704 :block/created-at 1792002820000]
  [10704 :block/order "c1ia"]
  [10704 :block/page 422]
  [10704 :block/parent 10698]
  [10704
   :block/title
   "(1) In this Act, excessive noise means any noise that is under human control and of such a nature as to unreasonably interfere with the peace, comfort, and con- venience of any person (other than a person in or at the place from which the noise is being emitted), but does not include any noise emitted by any—"]
  [10704 :block/updated-at 1792002820000]
  [10704 :block/uuid #uuid "6ad2f395-3e81-4218-ae37-877ccf82365a"]
  [10705 :block/created-at 1792002820000]
  [10705 :block/order "c1ie"]
  [10705 :block/page 422]
  [10705 :block/parent 10698]
  [10705
   :block/title
   "(2) Without limiting subsection (1), excessive noise—"]
  [10705 :block/updated-at 1792002820000]
  [10705 :block/uuid #uuid "6ad2f395-0307-4f84-a4c2-8e841b453cb8"]
  [10706 :block/created-at 1792002820000]
  [10706 :block/order "c1ij"]
  [10706 :block/page 422]
  [10706 :block/parent 10710]
  [10706 :block/title "(iii) a machine, however powered; or"]
  [10706 :block/updated-at 1792002820000]
  [10706 :block/uuid #uuid "6ad2f395-71cf-4c76-80d1-f43a02039249"]
  [10707 :block/created-at 1792002820000]
  [10707 :block/order "c1if"]
  [10707 :block/page 422]
  [10707 :block/parent 10705]
  [10707
   :block/title
   "(a) includes noise that exceeds a standard for noise prescribed by a national rule; and"]
  [10707 :block/updated-at 1792002820000]
  [10707 :block/uuid #uuid "6ad2f395-5089-4cf2-bbb9-542075e584a8"]
  [10708 :block/created-at 1792002820000]
  [10708 :block/order "c1ic"]
  [10708 :block/page 422]
  [10708 :block/parent 10704]
  [10708 :block/refs 289]
  [10708
   :block/title
   "(b) vehicle being driven on a road (within the meaning of [section 2]([[6ad2f38a-381e-4636-a9d9-a2ad3447616b]])(1) of the Land Transport Act 1998); or"]
  [10708 :block/updated-at 1792002820000]
  [10708 :block/uuid #uuid "6ad2f395-78d2-4720-be5d-681e083d24fc"]
  [10709 :block/created-at 1792002820000]
  [10709 :block/order "c1id"]
  [10709 :block/page 422]
  [10709 :block/parent 10704]
  [10709
