  [12952 :block/order "c2L5"]
  [12952 :block/page 337]
  [12952 :block/parent 12945]
  [12952 :block/refs 13876]
  [12952
   :block/title
   "(b) the territorial authority is not entitled to appoint a member to the [[6ad5b57f-dd2a-42d2-8d92-58043a01e788]] for the region in relation to the relevant draft:"]
