   :block/title
   "(a) notify the person who provided the financial assurance in writing within 10 working days after the date of the claim; and"]
  [6909 :block/updated-at 1792002820000]
  [6909 :block/uuid #uuid "6ad2f391-3ce7-42d6-8d57-33d07df83179"]
  [6910 :block/created-at 1792002820000]
  [6910 :block/order "c0eu"]
  [6910 :block/page 903]
  [6910 :block/parent 6819]
  [6910
   :block/title
   "(2) If the local authority, the consent authority, or the EPA requires a person to pro- vide an independent assessment under subclause (1), the person must pay any costs associated with obtaining the independent assessment."]
