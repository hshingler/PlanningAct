  [13799 :block/created-at 1792298839891]
  [13799 :block/order "aA"]
  [13799 :block/page 13771]
  [13799 :block/parent 13792]
  [13799
   :block/title
   "SW-Directive 2.3: To improve the resilience of communities to natural hazards, land use plans and natural environment plans must enable foreseeable emergency response and recovery activities."]
  [13799 :block/updated-at 1792298839891]
  [13799 :block/uuid #uuid "6ad44f57-1a0a-45f4-a916-0f64241ef6a8"]
  [13800 :block/created-at 1792298839891]
  [13800 :block/order "aB"]
  [13800 :block/page 13771]
  [13800 :block/parent 13799]
  [13800 :block/title ""]
  [13800 :block/updated-at 1792298839891]
  [13800 :block/uuid #uuid "6ad44f57-cceb-4966-8a61-e3954c21deda"]
  [13801 :block/created-at 1792298839891]
  [13801 :block/order "aC"]
  [13801 :block/page 13771]
  [13801 :block/parent 13792]
  [13801
   :block/title
   "SW-Directive 2.4: To improve the resilience of communities, land use plans and natural environment plans must enable the development and use of measures that reduce natural hazard risk and support adaptation."]
  [13801 :block/updated-at 1792298909316]
  [13801 :block/uuid #uuid "6ad44f57-9a98-4184-9584-2ca431130fc5"]
  [13802 :block/created-at 1792298839891]
  [13802 :block/order "aD"]
  [13802 :block/page 13771]
  [13802 :block/parent 13801]
  [13802 :block/title ""]
  [13802 :block/updated-at 1792298839891]
  [13802 :block/uuid #uuid "6ad44f57-c10b-4df2-8de0-d79727f3bde9"]
  [13803 :block/created-at 1792298839891]
  [13803 :block/order "aE"]
  [13803 :block/page 13771]
  [13803 :block/parent 13792]
  [13803
   :block/title
   "SW-Directive 2.5: To ensure a risk-based approach to natural hazard management, land use plans and natural environment plans must ensure that assessments of natural hazard risks take into account existing and proposed mitigation measures, residual risk, long-term hazard risk profiles, and where applicable, comply with any relevant requirements in national standards."]
  [13803 :block/updated-at 1792298918417]
  [13803 :block/uuid #uuid "6ad44f57-0640-49b5-8ae1-fb523b5cac81"]
  [13804 :block/created-at 1792298839891]
  [13804 :block/order "aF"]
  [13804 :block/page 13771]
  [13804 :block/parent 13803]
  [13804 :block/title ""]
  [13804 :block/updated-at 1792298839891]
  [13804 :block/uuid #uuid "6ad44f57-5706-46df-8ef5-327b079414e3"]
  [13805 :block/created-at 1792298839891]
  [13805 :block/order "aG"]
  [13805 :block/page 13771]
  [13805 :block/parent 13792]
  [13805
   :block/title
   "SW-Directive 2.6: To manage  proportionately, land use plans and natural environment must:"]
  [13805 :block/updated-at 1792298839891]
  [13805 :block/uuid #uuid "6ad44f57-683e-4652-9740-929c97538899"]
  [13806 :block/created-at 1792298839891]
  [13806 :block/order "aH"]
  [13806 :block/page 13771]
  [13806 :block/parent 13805]
  [13806
   :block/title
   "a) Scale the information requirements to assess  natural hazard risk to the anticipated level of risk."]
  [13806 :block/updated-at 1792298933252]
  [13806 :block/uuid #uuid "6ad44f57-51b3-4a5d-8ce7-46ddfb342423"]
  [13807 :block/created-at 1792298839891]
  [13807 :block/order "aI"]
  [13807 :block/page 13771]
  [13807 :block/parent 13805]
  [13807
   :block/title
   "b) Require avoidance and/or mitigation measures which are commensurate with the level of natural hazard risk, while also considering the cost-effectiveness of mitigation measures relative to the level of anticipated risk."]
  [13807 :block/updated-at 1792298939204]
  [13807 :block/uuid #uuid "6ad44f57-1d5d-44a8-bd2c-85dccdf55e24"]
