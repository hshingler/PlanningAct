   "(1) The local authorities of a region must do all things reasonably practicable to achieve consensus with each other when making a decision on any matter under this Act relating to the preparation, change, or implementation of a regional spatial plan."]
  [12923 :block/updated-at 1792002820000]
  [12923 :block/uuid #uuid "6ad2f398-0ed0-4401-b9da-1db6642f99db"]
  [12926 :block/created-at 1792002820000]
  [12926 :block/order "c2Kf"]
  [12926 :block/page 409]
  [12926 :block/parent 409]
  [12926
   :block/title
   "(2) The local authorities or the chairperson of the spatial plan committee (as the case requires) must advise the Minister that a decision is required on the matter."]
  [12926 :block/updated-at 1792002820000]
  [12926 :block/uuid #uuid "6ad2f398-8afc-4ca0-b1b1-4e3490ba4fa7"]
