  [8674 :block/uuid #uuid "6ad2f393-a31d-4614-9147-4e36430a3039"]
  [8675 :block/created-at 1792002820000]
  [8675 :block/order "c19d"]
  [8675 :block/page 259]
  [8675 :block/parent 259]
  [8675
   :block/title
   "A customary marine title group is an affected customary marine title group, in relation to an accommodated activity in the customary marine title area rele- vant to that group, if—"]
  [8675 :block/updated-at 1792002820000]
  [8675 :block/uuid #uuid "6ad2f393-d094-4d19-b69f-d6b37d65cafa"]
  [8680 :block/created-at 1792002820000]
  [8680 :block/order "c19f"]
  [8680 :block/page 259]
  [8680 :block/parent 8675]
  [8680 :block/refs 219]
  [8680
   :block/title
   "(b) the customary marine title group has not given written approval for the activity in a written notice received by the consent authority before the authority has made a determination under [section 149]([[6ad2f38a-e825-455c-80fd-0640266b6805]])(2)."]
  [8680 :block/updated-at 1792002820000]
  [8680 :block/uuid #uuid "6ad2f393-7d80-48b0-9a30-fb8d094e3299"]
  [8683 :block/created-at 1792002820000]
