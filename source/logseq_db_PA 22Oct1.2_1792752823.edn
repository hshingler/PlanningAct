  [9050 :block/uuid #uuid "6ad2f393-7b76-438d-a674-34e487ef2d76"]
  [9051 :block/created-at 1792002820000]
  [9051 :block/order "c1G3"]
  [9051 :block/page 536]
  [9051 :block/parent 9053]
  [9051
   :block/title
   "(a) subsections (2) and (3) are complied with; and"]
