  [8642 :block/parent 8649]
  [8642
   :block/title
   "(b) any adverse effect of the activity if a rule in a land use plan or a national rule permits an activity with that effect; and"]
  [8642 :block/updated-at 1792002820000]
  [8642 :block/uuid #uuid "6ad2f393-a257-4acd-aff6-6a1e19cb4c17"]
  [8645 :block/created-at 1792002820000]
