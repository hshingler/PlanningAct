  [9150 :block/created-at 1792002820000]
  [9150 :block/order "c1Hx"]
  [9150 :block/page 467]
  [9150 :block/parent 9156]
  [9150
   :block/title
   "(a) as if the planning consent were goods within the meaning of that Act; and"]
  [9150 :block/updated-at 1792002820000]
  [9150 :block/uuid #uuid "6ad2f393-187b-4f20-84d3-2fb9f8562079"]
  [9151 :block/created-at 1792002820000]
  [9151 :block/order "c1Hp8"]
  [9151 :block/page 467]
  [9151 :block/parent 467]
  [9151
   :block/title
   "(1) A planning consent is neither real nor personal property."]
  [9151 :block/updated-at 1792002820000]
  [9151 :block/uuid #uuid "6ad2f393-c110-4b15-9c6e-edaea4cf47ea"]
  [9152 :block/created-at 1792002820000]
  [9152 :block/order "c1Ht"]
  [9152 :block/page 467]
  [9152 :block/parent 9163]
  [9152
   :block/title
   "(b) on the bankruptcy of an individual who is the consent holder, the consent vests in the Official Assignee as if it were personal property, and the Official Assignee may deal with the consent to the same extent as the holder would have been able to do; and"]
  [9152 :block/updated-at 1792002820000]
  [9152 :block/uuid #uuid "6ad2f393-2d0b-4099-a421-912ebcdad6c9"]
  [9155 :block/created-at 1792002820000]
  [9155 :block/order "c1Hu"]
  [9155 :block/page 467]
  [9155 :block/parent 9163]
  [9155
   :block/title
